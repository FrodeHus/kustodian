#!/bin/sh
# The AppImage's entry point. The AppImage runtime sets APPDIR to the mounted (or extracted) AppDir; when AppRun is run
# from an unpacked AppDir directly, the AppDir is the folder this file is in.
set -eu
APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
exec "$APPDIR/usr/bin/Kustodian" "$@"
