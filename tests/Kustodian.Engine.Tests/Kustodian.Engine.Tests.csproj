<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kustodian.Engine\Kustodian.Engine.csproj" />
    <!-- The worker program is not referenced for its code: its whole output folder is copied to engine-worker/ under the test
         output, and the pool tests start Kustodian.TestEngineWorker.dll from there on the dotnet host. -->
    <ProjectReference Include="..\Kustodian.TestEngineWorker\Kustodian.TestEngineWorker.csproj" OutputItemType="EngineWorkerAssembly" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="IncludeEngineWorker" AfterTargets="ResolveProjectReferences" Condition="'@(EngineWorkerAssembly)' != ''">
    <PropertyGroup>
      <_EngineWorkerDir>@(EngineWorkerAssembly->'%(RootDir)%(Directory)')</_EngineWorkerDir>
    </PropertyGroup>
    <ItemGroup>
      <_EngineWorkerFile Include="$(_EngineWorkerDir)**/*" />
      <ContentWithTargetPath Include="@(_EngineWorkerFile)">
        <TargetPath>engine-worker/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

</Project>
