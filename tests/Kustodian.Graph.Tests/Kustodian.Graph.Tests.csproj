<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Schema\permissions-excerpt.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared with the web's findParams test: both sides must find the same placeholders. -->
    <None Include="..\..\web\src\params\find-params.fixture.json" Link="Query\find-params.fixture.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kustodian.Graph\Kustodian.Graph.csproj" />
    <!-- The worker program is not referenced for its code: its whole output folder is copied to engine-worker/ under the test
         output, and the runner tests start Kustodian.EngineWorker.dll from there on the dotnet host. -->
    <ProjectReference Include="..\Kustodian.EngineWorker\Kustodian.EngineWorker.csproj" OutputItemType="EngineWorkerAssembly" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="IncludeEngineWorker" AfterTargets="ResolveProjectReferences" Condition="'@(EngineWorkerAssembly)' != ''">
    <PropertyGroup>
      <_EngineWorkerDir>@(EngineWorkerAssembly->'%(RootDir)%(Directory)')</_EngineWorkerDir>
    </PropertyGroup>
    <ItemGroup>
      <_EngineWorkerFile Include="$(_EngineWorkerDir)**/*" />
      <ContentWithTargetPath Include="@(_EngineWorkerFile)">
        <TargetPath>engine-worker/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

</Project>
