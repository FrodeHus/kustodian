<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- A release publish (tools/release/publish.sh, any -r): one self-contained executable, the native libraries (Photino)
       inside it and extracted on first run, the symbols embedded. No trimming: MSAL, Kusto.Language and the bridge's JSON use
       reflection. Without a runtime identifier (dotnet build, dotnet test) none of this applies. The referenced projects build
       without the runtime identifier, so Directory.Build.props embeds their symbols in Release. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <AssemblyName>Kustodian</AssemblyName>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- On Windows the app is a GUI executable, so no console window opens beside it; the engine worker it starts has no window
       either (CreateNoWindow), and the version flag attaches to the parent's console (WindowsConsole). -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kustodian.Graph\Kustodian.Graph.csproj" />
    <ProjectReference Include="..\Kustodian.Engine\Kustodian.Engine.csproj" />
    <ProjectReference Include="..\Kustodian.Sources\Kustodian.Sources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Snippets\builtin-snippets.json" LogicalName="builtin-snippets.json" />
  </ItemGroup>

  <!-- The web UI is embedded under wwwroot/ and served on app://. With a web project (web/package.json), web/dist is built by
       npm when it is missing or older than its sources, then embedded. Without one, a built-in placeholder page is embedded,
       so the host builds without Node. -->
  <PropertyGroup>
    <KustodianWebDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\web'))</KustodianWebDir>
    <KustodianWebDist>$(KustodianWebDir)dist\</KustodianWebDist>
    <KustodianHasWeb Condition="Exists('$(KustodianWebDir)package.json')">true</KustodianHasWeb>
  </PropertyGroup>

  <ItemGroup Condition="'$(KustodianHasWeb)' != 'true'">
    <None Remove="App\placeholder.html" />
    <EmbeddedResource Include="App\placeholder.html" LogicalName="wwwroot/index.html" />
  </ItemGroup>

  <ItemGroup Condition="'$(KustodianHasWeb)' == 'true'">
    <KustodianWebInput Include="$(KustodianWebDir)src\**\*" />
    <KustodianWebInput Include="$(KustodianWebDir)index.html;$(KustodianWebDir)package.json;$(KustodianWebDir)package-lock.json;$(KustodianWebDir)vite.config.ts" />
  </ItemGroup>

  <Target Name="KustodianBuildWeb" Condition="'$(KustodianHasWeb)' == 'true' And '$(DesignTimeBuild)' != 'true'"
          Inputs="@(KustodianWebInput)" Outputs="$(KustodianWebDist)index.html">
    <Exec Command="npm ci" WorkingDirectory="$(KustodianWebDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(KustodianWebDir)" />
    <Touch Files="$(KustodianWebDist)index.html" />
  </Target>

  <Target Name="KustodianEmbedWeb" Condition="'$(KustodianHasWeb)' == 'true'" DependsOnTargets="KustodianBuildWeb"
          BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <!-- Items made inside a target can't read their own %(RecursiveDir): list the files first, then batch over that list. -->
      <KustodianWebFile Include="$(KustodianWebDist)**\*" />
      <EmbeddedResource Include="@(KustodianWebFile)" LogicalName="wwwroot/$([System.String]::Copy('%(KustodianWebFile.RecursiveDir)').Replace('\', '/'))%(KustodianWebFile.Filename)%(KustodianWebFile.Extension)" />
    </ItemGroup>
  </Target>

</Project>
